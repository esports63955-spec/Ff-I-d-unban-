<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Status Console</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
        }

        body {
            background-color: #050505;
            color: #00ff66;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .console-card {
            width: 100%;
            max-width: 400px;
            background-color: #0a0c0a;
            border: 2px solid #00ff66;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 0 20px rgba(0, 255, 102, 0.2);
            text-align: center;
            position: relative;
        }

        .status-icon {
            width: 60px;
            height: 60px;
            border: 2px solid #00ff66;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px auto;
            box-shadow: 0 0 10px rgba(0, 255, 102, 0.4);
        }

        .status-icon svg {
            width: 30px;
            height: 30px;
            stroke: #00ff66;
        }

        .sub-header {
            font-size: 11px;
            letter-spacing: 1.5px;
            color: #00cc52;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .main-title {
            font-size: 20px;
            font-weight: bold;
            letter-spacing: 2px;
            color: #ffffff;
            text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
            margin-bottom: 25px;
        }

        .details-box {
            border: 1px solid rgba(0, 255, 102, 0.3);
            background-color: rgba(0, 255, 102, 0.03);
            padding: 15px;
            border-radius: 6px;
            text-align: left;
            margin-bottom: 20px;
            font-size: 12px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .detail-row:last-child {
            margin-bottom: 0;
        }

        .label {
            color: #888;
        }

        .value {
            color: #ffffff;
            font-weight: bold;
        }

        .value.highlight {
            color: #00ff66;
        }

        .message-text {
            font-size: 11px;
            color: #a0a0a0;
            line-height: 1.4;
            margin-bottom: 25px;
        }

        .action-button {
            width: 100%;
            padding: 12px;
            background: linear-gradient(180deg, #00aa44 0%, #005522 100%);
            border: 1px solid #00ff66;
            color: #ffffff;
            font-weight: bold;
            letter-spacing: 1.5px;
            border-radius: 4px;
            cursor: pointer;
            text-shadow: 0 1px 2px #000;
            box-shadow: 0 0 10px rgba(0, 255, 102, 0.3);
            transition: all 0.2s ease;
        }

        .action-button:hover {
            background: linear-gradient(180deg, #00cc52 0%, #007733 100%);
            box-shadow: 0 0 15px rgba(0, 255, 102, 0.5);
        }
    </style>
</head>
<body>

    <div class="console-card">
        <!-- Status Icon -->
        <div class="status-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>

        <!-- Header -->
        <div class="sub-header">System Confirmation // Status</div>
        <div class="main-title">PROCESS COMPLETED</div>

        <!-- Details Container -->
        <div class="details-box">
            <div class="detail-row">
                <span class="label">TARGET ID:</span>
                <span class="value">123456789</span>
            </div>
            <div class="detail-row">
                <span class="label">DURATION:</span>
                <span class="value">7 DAYS</span>
            </div>
            <div class="detail-row">
                <span class="label">CLIENT IP:</span>
                <span class="value">192.168.1.1</span>
            </div>
            <div class="detail-row">
                <span class="label">STATUS:</span>
                <span class="value highlight">ACTIVE [OK]</span>
            </div>
            <div class="detail-row">
                <span class="label">VERSION:</span>
                <span class="value">CORE v1.0</span>
            </div>
            <div class="detail-row">
                <span class="label">TIME STAMP:</span>
                <span class="value">2026-09-27 00:00 UTC</span>
            </div>
        </div>

        <!-- Footer Message -->
        <div class="message-text">
            > SYSTEM DATABASE SUCCESSFULLY UPDATED.<br>STATUS CONFIRMED.
        </div>

        <!-- Action Button -->
        <button class="action-button">OK / CLOSE CONSOLE</button>
    </div>

</body>
</html>
